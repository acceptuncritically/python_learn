   "source": [
    "import pandas as pd\n",
    "\n",
    "#读取数据\n",
    "df=pd.read_csv(\"csv_data/学生成绩.csv\",usecols=[\"姓名\",\"语文\",\"数学\",\"英语\"])\n",
    "# usecols用来控制要输出的列\n",
    "\n",
    "# 动态的增加一列\n",
    "df[\"总成绩\"]=df[\"语文\"]+df[\"数学\"]+df[\"英语\"]\n",
    "\n",
    "#写入数据 写入一个新csv里 to_csv\n",
    "#index=False 表示索引列不写入文件中\n",
    "df.to_csv(\"csv_data/学生成绩_01.csv\",index=False)"
   ],
