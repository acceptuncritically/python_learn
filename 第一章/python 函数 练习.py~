def calc(*args, coupon,score,express):
    """
    根据传入信息计算价格
    :param args: 商品名 价格 数量   用列表/字典 解决
    :param coupon: 优惠卷
    :param score: 积分
    :param express: 运费
    :return: 最终价格
    """
    total=[goods[1]*goods[2] for goods in args]
    total_cost=sum(total)

    if total_cost>=5000 and total_cost>=coupon:
        total_cost-=coupon
    if total_cost>=5000 and (score//100) <= total_cost:
        total_cost-=score//100
    total_cost+=express
    return total_cost
a=calc(("鼠标",168,2)("键盘",388,1),coupon=10,score=4000,express=9.9)#用不定长来区分谁在args里
